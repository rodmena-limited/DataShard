DATASHARD_STORAGE_TYPE=s3
DATASHARD_S3_ENDPOINT=https://s3.<your-domain>
DATASHARD_S3_ACCESS_KEY=rodmena-limited
DATASHARD_S3_SECRET_KEY=distributed-password-change-me
DATASHARD_S3_BUCKET=datashard
DATASHARD_S3_REGION=us-east-1
TEST_TABLE_PATH=highway-test-logs

# Locking. Leave unset: datashard probes the endpoint once and uses compare-and-swap
# (conditional PUT) locking when the provider honours it - AWS S3, OVH Object Storage,
# MinIO and most others do. "false" selects the best-effort polling lock, which can
# LOSE commits under concurrency (#59) and therefore also requires
# DATASHARD_S3_ALLOW_UNSAFE_LOCK=1.
# DATASHARD_S3_USE_CONDITIONAL_WRITES=true
